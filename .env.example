# Copy to .env for local overrides (dotenv-rails loads it in dev/test).
# Config lives in env vars; reach for encrypted credentials only when something needs encrypting.

# Development / test — all optional, defaults match the README's Postgres one-liner
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_USER=postgres
# DATABASE_PASSWORD=postgres
# PORT=3000

# Production — required (set in your deploy's env file, not here)
# SECRET_KEY_BASE=   # generate with: bin/rails secret
# DATABASE_URL=postgres://user:password@host:5432/app_production
# ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
# ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
# ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=   # one line, literal \n between lines (see README)
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# PITCREW_INITIAL_USER=
# One per resolver sidecar: RESOLVER_<RUNTIME>_<MAJOR>_<MINOR>=<url>
# RESOLVER_RUBY_3_3=http://pitcrew-ruby33:9292
# RESOLVER_RUBY_3_4=http://pitcrew-ruby34:9292
# PITCREW_WORK_DIR=/work
# GOOD_JOB_EXECUTION_MODE=async   # optional: run jobs in the web process instead of a good_job container
# ADVISORY_DB_PATH=

# Development: the GitHub App vars above (a dev App; see README → GitHub App), plus the
# local resolver sidecars from docker-compose.resolvers.yml:
# RESOLVER_RUBY_3_3=http://127.0.0.1:9333
# RESOLVER_RUBY_3_4=http://127.0.0.1:9334
